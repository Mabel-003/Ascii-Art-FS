	package piscine

import "fmt"

func QuadA(x, y int) {
    if x <= 0 || y <= 0 { // comment here
        return
    }

    // Print top line
    if x == 1 {
        fmt.Println("o")
    } else {
        fmt.Print("o")
        for i := 0; i < x-2; i++ {
            fmt.Print("-")
        }
        fmt.Println("o")
    }

    // Print middle lines
    for j := 0; j < y-2; j++ {
        if x == 1 {
            fmt.Println("|")
        } else {
            fmt.Print("|")
            for i := 0; i < x-2; i++ {
                fmt.Print(" ")
            }
            fmt.Println("|")
        }
    }

    // Print bottom line (only if height > 1)
    if y > 1 {
        if x == 1 {
            fmt.Println("o")
        } else {
            fmt.Print("o")
            for i := 0; i < x-2; i++ {
                fmt.Print("-")
            }
            fmt.Println("o")
        }
    }
}
